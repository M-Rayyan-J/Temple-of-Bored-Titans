.hud-root { flex-grow: 1; padding-left: 24px; padding-right: 24px; padding-top: 20px; padding-bottom: 18px; justify-content: space-between; }
.top-row { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.status-label { color: rgb(236, 222, 184); background-color: rgba(16, 22, 20, 0.82); padding-left: 14px; padding-right: 14px; padding-top: 9px; padding-bottom: 9px; border-left-width: 2px; border-left-color: rgb(197, 154, 54); font-size: 17px; -unity-font-style: bold; }
.score-label { border-left-color: rgb(118, 80, 160); }
.objective-label { align-self: flex-start; color: rgb(220, 224, 218); background-color: rgba(16, 22, 20, 0.78); padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; font-size: 14px; }
.prompt-label { align-self: center; margin-bottom: 28px; color: rgb(255, 239, 195); background-color: rgba(12, 16, 14, 0.88); padding-left: 22px; padding-right: 22px; padding-top: 12px; padding-bottom: 12px; font-size: 18px; -unity-font-style: bold; display: none; }
.notification-label { align-self: center; margin-bottom: 12px; color: rgb(240, 217, 158); background-color: rgba(18, 23, 19, 0.9); padding-left: 18px; padding-right: 18px; padding-top: 10px; padding-bottom: 10px; font-size: 16px; display: none; }
.health-label { border-left-color: rgb(147, 35, 39); }
.weapon-label { border-left-color: rgb(117, 124, 136); }
.boss-label { position: absolute; top: 66px; left: 30%; right: 30%; color: rgb(224, 205, 194); background-color: rgba(24, 8, 10, .85); border-bottom-width: 2px; border-bottom-color: rgb(133, 28, 33); padding: 8px; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; display: none; }
.crosshair { position: absolute; left: 50%; top: 50%; color: rgba(236, 225, 212, .85); font-size: 24px; -unity-text-align: middle-center; }
.ending-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(5, 3, 5, .92); justify-content: center; align-items: center; display: none; }
.ending-title { color: rgb(176, 40, 43); font-size: 44px; -unity-font-style: bold; margin-bottom: 16px; -unity-text-align: middle-center; }
.ending-body { color: rgb(222, 215, 204); font-size: 20px; -unity-text-align: middle-center; max-width: 720px; white-space: normal; }
