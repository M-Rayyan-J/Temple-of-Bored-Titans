.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(23, 37, 31, 0.92);
}
.title-panel {
    align-items: center;
    padding: 36px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(197, 154, 54);
    border-right-color: rgb(197, 154, 54);
    border-top-color: rgb(197, 154, 54);
    border-bottom-color: rgb(197, 154, 54);
    background-color: rgba(10, 14, 12, 0.82);
}
.title {
    color: rgb(224, 194, 119);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.subtitle {
    margin-top: 12px;
    color: rgb(200, 205, 196);
    font-size: 15px;
    -unity-text-align: middle-center;
}
